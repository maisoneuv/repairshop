# Django
DJANGO_SECRET_KEY='your-secret-key-here'
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Europe/Warsaw
DJANGO_STATIC_ROOT='/src/static/'
DJANGO_DEFAULT_TENANT_SUBDOMAIN='tenant'

# CORS/CSRF (adjust to your domain)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8008
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8008

# Database
DB_HOST=db
DB_NAME=db_name
DB_USER=postgres
DB_PASS=postgres
DB_PORT=5432

# Celery & Redis (for background tasks and integrations)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email
# Local dev: keep console backend — emails print to the Django/Docker terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Global no-reply address for system emails (password resets, invitations).
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# Production: Resend via django-anymail (see docs/EMAIL_SETUP.md for full setup).
# 1. Sign up at resend.com → verify your platform sending domain (mail.yourdomain.com)
# 2. Add an inbound domain (reply.yourdomain.com, MX record) for customer replies
# 3. Register the two webhooks (tracking + inbound) and copy their svix secrets
#
# EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_SIGNING_SECRET=whsec_...   # tracking webhook secret
# RESEND_INBOUND_SECRET=whsec_...   # inbound webhook secret
RESEND_API_KEY=
RESEND_SIGNING_SECRET=
RESEND_INBOUND_SECRET=

# Platform sending/reply domains (tenant emails go out as <slug>@PLATFORM_EMAIL_DOMAIN;
# replies come back via reply+<token>@PLATFORM_REPLY_DOMAIN).
PLATFORM_EMAIL_DOMAIN=mail.yourdomain.com
PLATFORM_REPLY_DOMAIN=reply.yourdomain.com

# How many times a failed send is retried with exponential backoff.
EMAIL_SEND_MAX_RETRIES=5

# Legacy Mailgun config (no longer used by new code paths; kept for fallback).
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=
MAILGUN_API_URL=https://api.mailgun.net/v3

# Base URL of the frontend — used to build password reset links in emails.
# Must match the actual domain users visit (no trailing slash).
FRONTEND_BASE_URL=http://localhost:5173
