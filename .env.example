# Django
DJANGO_SECRET_KEY='your-secret-key-here'
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Europe/Warsaw
DJANGO_STATIC_ROOT='/src/static/'
DJANGO_DEFAULT_TENANT_SUBDOMAIN='tenant'

# CORS/CSRF (adjust to your domain)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8008
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8008

# Database
DB_HOST=db
DB_NAME=db_name
DB_USER=postgres
DB_PASS=postgres
DB_PORT=5432

# Celery & Redis (for background tasks and integrations)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email
# Local dev: keep console backend — emails print to the Django/Docker terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# Production: switch to Mailgun via django-anymail (HTTPS, no raw SMTP port issues).
# 1. Sign up at mailgun.com → add a sending domain (e.g. mg.yourdomain.com)
# 2. Add the 3 DNS records Mailgun shows you to your domain registrar
# 3. Set the vars below and change EMAIL_BACKEND to the anymail backend
#
# EMAIL_BACKEND=anymail.backends.mailgun.EmailBackend
# MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAILGUN_SENDER_DOMAIN=mg.yourdomain.com
# If your Mailgun account is in the EU region:
# MAILGUN_API_URL=https://api.eu.mailgun.net/v3
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=
MAILGUN_API_URL=https://api.mailgun.net/v3

# Base URL of the frontend — used to build password reset links in emails.
# Must match the actual domain users visit (no trailing slash).
FRONTEND_BASE_URL=http://localhost:5173
